# SafeX Fintech Subscription Billing Portal - Environment Configuration
PORT=5000
NODE_ENV=development

# Supabase / PostgreSQL Connection String (Transaction Pooler or Direct URI)
# Example Supabase URI: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Example Local URI: postgresql://postgres:postgres@localhost:5432/safex_billing_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safex_billing_db

# Frontend API Base (For React Client)
REACT_APP_API_BASE=http://localhost:5000/api
